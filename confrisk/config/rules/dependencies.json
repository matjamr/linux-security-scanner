{
  "version": "1.0",
  "description": "Dependency security rules - vulnerable packages, EOL software, insecure versions",

  "package_managers": [
    {
      "name": "npm",
      "manifest_files": ["package.json", "package-lock.json"],
      "command": "npm audit --json"
    },
    {
      "name": "pip",
      "manifest_files": ["requirements.txt", "Pipfile", "poetry.lock"],
      "command": "pip-audit --format json"
    },
    {
      "name": "apt",
      "manifest_files": ["/var/lib/dpkg/status"],
      "command": "apt list --installed"
    },
    {
      "name": "yum",
      "manifest_files": ["/var/lib/rpm"],
      "command": "yum list installed"
    },
    {
      "name": "cargo",
      "manifest_files": ["Cargo.lock"],
      "command": "cargo audit --json"
    },
    {
      "name": "go",
      "manifest_files": ["go.mod", "go.sum"],
      "command": "govulncheck -json ./..."
    }
  ],

  "blocklist": {
    "description": "Packages that should never be used",
    "packages": [
      {
        "name": "request",
        "ecosystem": "npm",
        "reason": "Deprecated, unmaintained since 2020",
        "severity": "medium",
        "alternative": "axios, node-fetch, got"
      },
      {
        "name": "node-uuid",
        "ecosystem": "npm",
        "reason": "Deprecated, use 'uuid' instead",
        "severity": "low",
        "alternative": "uuid"
      },
      {
        "name": "cryptiles",
        "ecosystem": "npm",
        "reason": "Known vulnerabilities, unmaintained",
        "severity": "high",
        "alternative": "crypto (native)"
      },
      {
        "name": "event-stream",
        "ecosystem": "npm",
        "reason": "Supply chain attack history (2018)",
        "severity": "critical",
        "alternative": "through2, readable-stream"
      },
      {
        "name": "colors",
        "ecosystem": "npm",
        "version_pattern": "^1.4.[1-4]$",
        "reason": "Malicious code in versions 1.4.1-1.4.4 (infinite loop DoS)",
        "severity": "critical",
        "alternative": "chalk, ansi-colors"
      },
      {
        "name": "faker",
        "ecosystem": "npm",
        "version_pattern": "^6.6.6$",
        "reason": "Malicious version 6.6.6 (same author as colors attack)",
        "severity": "critical",
        "alternative": "@faker-js/faker"
      },
      {
        "name": "ua-parser-js",
        "ecosystem": "npm",
        "version_pattern": "^0.7.29|^0.8.0|^1.0.0",
        "reason": "Compromised versions 0.7.29, 0.8.0, 1.0.0 with crypto miners",
        "severity": "critical",
        "alternative": "ua-parser-js >= 0.7.31"
      },
      {
        "name": "coa",
        "ecosystem": "npm",
        "version_pattern": "^2.0.3$",
        "reason": "Compromised version 2.0.3 with password stealer",
        "severity": "critical",
        "alternative": "coa >= 2.0.4"
      },
      {
        "name": "rc",
        "ecosystem": "npm",
        "version_pattern": "^1.[0-1].*",
        "reason": "Prototype pollution vulnerability (CVE-2018-16487)",
        "severity": "high",
        "alternative": "rc >= 1.2.8"
      },
      {
        "name": "minimist",
        "ecosystem": "npm",
        "version_pattern": "^0.*|^1.2.[0-4]",
        "reason": "Prototype pollution vulnerability (CVE-2020-7598, CVE-2021-44906)",
        "severity": "high",
        "alternative": "minimist >= 1.2.6"
      },
      {
        "name": "ini",
        "ecosystem": "npm",
        "version_pattern": "^1.[0-2].*",
        "reason": "Prototype pollution vulnerability (CVE-2020-7788)",
        "severity": "high",
        "alternative": "ini >= 1.3.6"
